# Проверка создания функции
молвить(" ") гойда
молвить("Проверка создания функции") гойда

сотвори факториал(n) изречет цело ухожу я в пляс
    результат = 1 гойда
    покуда n > 1 ухожу я в пляс
        результат = результат * n гойда
        n = n - 1 гойда
    закончили пляски
    возверни результат
закончили пляски

сотвори возвысь(основа, степень) изречет плывун ухожу я в пляс
    возверни основа ** степень
закончили пляски

результат = факториал(5) гойда
глас (результат) гойда

результат = возвысь(2, 3) гойда
глас(результат) гойда

