#  Тест встроенной функции дебага "Глас"

ящер = 42 гойда
глас(ящер) гойда

число = 5 + 3 гойда
глас(число) гойда

ХЗ быти двосуть = Ложь гойда
глас(ХЗ) гойда

строчка = "змей" гойда
глас(строчка) гойда

плывунок = 3.14 гойда
глас(плывунок) гойда

спис = созвать_дружину(3, 42) гойда
глас(спис) гойда

точный быти плывун малый точный = 1.234 гойда
глас(точный) гойда

великий быти плывун великий = 5.678 гойда
глас(великий) гойда

звездный быти плывун звездный = 9.876 гойда
глас(звездный) гойда


#  Проверка "Глас" на функциях 
#1
сотвори квадрат(число быти плывун малый точный) изречет плывун малый точный ухожу я в пляс
    возверни число ** 2
закончили пляски

глас(квадрат(10)) гойда

#2
сотвори двосуть(б быти двосуть) изречет двосуть ухожу я в пляс
    возверни б
закончили пляски

глас(двосуть(Истина)) гойда
глас(двосуть(Ложь)) гойда

#3
сотвори строка_и_число(вход быти строченька, n быти цело) изречет строченька ухожу я в пляс
    результат = вход + " " + n гойда
    возверни результат
закончили пляски

глас(строка_и_число("Матушка земля", 5)) гойда