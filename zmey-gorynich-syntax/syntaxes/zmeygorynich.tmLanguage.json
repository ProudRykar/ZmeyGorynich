{
    "name": "Zmey Gorynich",
    "scopeName": "source.zmeygorynich",
    "fileTypes": [".zg"],
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#braces"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#type_annotations"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#import_statement"
        },
        {
            "include": "#special_variables"
        },
        {
            "include": "#identifiers"
        },
        {
            "include": "#goyda"
        }
    ],
    "repository": {
        "braces": {
            "patterns": [
                {
                    "name": "keyword.brace.open.zmeygorynich",
                    "match": "\\bухожу я в пляс\\b",
                    "settings": {
                        "foreground": "#F78C6C",
                        "fontStyle": "bold"
                    }
                },
                {
                    "name": "keyword.brace.close.zmeygorynich",
                    "match": "\\bзакончили пляски\\b",
                    "settings": {
                        "foreground": "#F78C6C",
                        "fontStyle": "bold"
                    }
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.zmeygorynich",
                    "match": "\\b(покуда|молвить|внемли|ино|аще|ли|то|дважды|трижды|четырежды|пятьжды|шестьжды|семьжды|осьмьжды|девятьжды|десятьжды|стожды|сотвори|изречет|возверни|созвать_дружину|глас)\\b",
                    "settings": {
                        "foreground": "#FFCB6B"
                    }
                }
            ]
        },
        "type_annotations": {
            "patterns": [
                {
                    "match": "\\b(быти)\\b\\s+\\b(цело|плывун|строченька|двосуть|список цело|список плывун|список строченька|список двосуть|плывун малый точный|плывун великий|плывун звездный)\\b",
                    "captures": {
                        "1": { "name": "keyword.type.annotation.zmeygorynich" },
                        "2": { "name": "storage.type.zmeygorynich" }
                    }
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.zmeygorynich",
                    "match": "[+\\-*/%<>==!]+|\\*\\*",
                    "settings": {
                        "foreground": "#89DDFF"
                    }
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.zmeygorynich",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.zmeygorynich",
                            "match": "\\\\.",
                            "settings": {
                                "foreground": "#FF4500"
                            }
                        }
                    ],
                    "settings": {
                        "foreground": "#C3E88D"
                    }
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.zmeygorynich",
                    "match": "\\b\\d+\\b",
                    "settings": {
                        "foreground": "#82AAFF"
                    }
                }
            ]
        },
        "import_statement": {
            "patterns": [
                {
                    "match": "\\b(прочесть книгу)\\s+(\"[^\"]+\")\\s+(и осмыслить слова как)\\s+(\\w+)",
                    "captures": {
                        "1": { "name": "keyword.control.import.zmeygorynich" },
                        "2": { "name": "string.quoted.double.zmeygorynich" },
                        "3": { "name": "keyword.control.import.zmeygorynich" },
                        "4": { "name": "variable.zmeygorynich" }
                    },
                    "settings": {
                        "1": { "foreground": "#FFCB6B" },
                        "2": { "foreground": "#C3E88D" },
                        "3": { "foreground": "#FFCB6B" },
                        "4": { "foreground": "#82AAFF" }
                    }
                }
            ]
        },
        "special_variables": {
            "patterns": [
                {
                    "name": "string.special.zmeygorynich",
                    "match": "\\bимпорт\\.импортируемая\\b",
                    "settings": {
                        "foreground": "#82AAFF"
                    }
                }
            ]
        },
        "identifiers": {
            "patterns": [
                {
                    "name": "variable.zmeygorynich",
                    "match": "\\b(?!покуда|молвить|внемли|ино|аще|ли|то|гойда|возверни|созвать_дружину|глас)\\w+\\b",
                    "settings": {
                        "foreground": "#B0C9FF"
                    }
                }
            ]
        },
        "goyda": {
            "patterns": [
                {
                    "name": "punctuation.terminator.zmeygorynich",
                    "match": "\\bгойда\\b",
                    "settings": {
                        "foreground": "#5C6370",
                        "fontStyle": "italic"
                    }
                }
            ]
        },
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.number-sign.zmeygorynich",
                    "match": "#.*$",
                    "settings": {
                        "foreground": "#6A9955",
                        "fontStyle": "italic"
                    }
                },
                {
                    "name": "comment.block.zmeygorynich",
                    "begin": "Голос\\s+предков\\s+шепчет\\s*:",
                    "end": "Голос\\s+предков\\s+внезапно\\s+стих\\.\\.\\.",
                    "contentName": "comment.block.zmeygorynich",
                    "settings": {
                        "foreground": "#6A9955",
                        "fontStyle": "italic"
                    }
                }
            ]
        }
    }
}